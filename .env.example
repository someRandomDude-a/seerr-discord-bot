# Minimal bootstrap. Configure credentials, presets and advanced options in the local panel.
# Native default: ./data. Docker: /data, mounted read-write and owned by UID 10001.
DATA_DIR=./data
# Start the local setup/admin panel alongside the bot. false is for configured headless installs.
PANEL_ENABLED=true
# Loopback is safest. Docker requires 0.0.0.0 INSIDE the container and host-loopback publishing.
# Never expose this HTTP panel publicly; its console access code grants local operator access.
PANEL_HOST=127.0.0.1
# 0 selects an available random local port, printed at startup. Docker uses a fixed container
# port (e.g. 8787) with a random host-loopback port; see docs/onboarding.md.
PANEL_PORT=0
