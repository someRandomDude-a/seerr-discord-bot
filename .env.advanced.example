# Advanced reference: normally configure these in the local admin panel, not .env.
# Environment entries override saved settings; remove an override before editing in the panel.
# Booleans accept true/false only (case-insensitive).
# Secrets stay server-side. All intervals/TTLs are in seconds, all counts are integers.

# Required Seerr base URL, without /api/v1; HTTPS required for secure-cookie CSRF setups.
SEERR_URL=http://seerr:5055
# Required Seerr administrator API key; user requests still impersonate the linked user.
SEERR_ADMIN_KEY=replace-me
# Required bot token from Developer Portal -> Bot. Never use a personal Discord token.
DISCORD_TOKEN=replace-me

# Import every Radarr/Sonarr instance from Seerr on every refresh; recommended default.
# false permits legacy direct RADARR/SONARR URL/key overrides below instead.
SEERR_DISCOVERY=true
# Give verified linked Seerr owners/admins bot admin access, revalidated against live Seerr.
# ADMIN_DISCORD_IDS remain explicit bot-only exceptions. Outages block inferred admin actions.
SEERR_ADMINS=true

# Optional embedded dashboard. false keeps ALL features in slash commands/components.
# Requires public HTTPS URL Mapping and an Activity build when true. No public IP needed.
ACTIVITY_ENABLED=false
# Application ID for the same bot; required only when ACTIVITY_ENABLED=true.
DISCORD_APPLICATION_ID=
# OAuth2 client secret; required only when ACTIVITY_ENABLED=true. Never expose to clients.
DISCORD_CLIENT_SECRET=
# Activity session lifetime, >=1; capped by Discord OAuth expiry. Reopen to reauthenticate.
ACTIVITY_SESSION_TTL_SECONDS=900
# Visible Activity auto-refresh interval, >=30; pauses during search, editing and confirmation.
ACTIVITY_REFRESH_INTERVAL_SECONDS=60

# Persistent-data directory, created on startup; mount/back up this directory in Docker.
DATA_DIR=./data
# SQLite filename relative to DATA_DIR, or absolute path. Run only one bot per database.
DATABASE_PATH=seerr_cache.db
# Per outbound media/Discord OAuth HTTP-call timeout, >=1; not a whole-refresh deadline.
API_TIMEOUT_SECONDS=15
# Background media refresh/notification/deletion-check interval, >=1. Actions also refresh.
SYNC_INTERVAL_SECONDS=300
# Private Jellyfin Quick Connect code lifetime, >=1; values above 300 are capped at 300.
LINK_TTL_SECONDS=300
# Native /link approval polling interval, >=1. Activity polls approval every 5 seconds.
LINK_POLL_INTERVAL_SECONDS=5

# Comma-separated allowed guild IDs. Empty allows all guilds/DMs; nonempty blocks DM commands.
# This restricts command/Activity entry, not operators' explicitly selected broadcast targets.
ALLOWED_GUILD_IDS=
# User command/component/general Activity actions allowed per RATE_LIMIT_WINDOW_SECONDS, >=1.
RATE_LIMIT_COUNT=15
# Rolling interaction-rate window, >=1. Command and Activity limits are shared per user.
RATE_LIMIT_WINDOW_SECONDS=60
# Quick Connect starts per user per LOGIN_RATE_LIMIT_WINDOW_SECONDS, >=1.
LOGIN_RATE_LIMIT_COUNT=5
# Rolling connection-start window, >=1. Separate from normal interaction limits.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# Comma-separated bot-only operator exceptions, in addition to verified Seerr admins.
# Role exceptions still require /link and a valid Jellyfin user token.
# Empty means Seerr admins only. Disable SEERR_ADMINS too to disable Discord/Activity operators.
ADMIN_DISCORD_IDS=
# JSON guild ID -> channel ID (quote IDs). Example: {"123456789012345678":"234567890123456789"}.
# Cross-server/Activity sends use this or the system channel; local /announce uses its channel.
ADMIN_ANNOUNCEMENT_CHANNELS={}
# Enable AND turn on Server Members Intent in Developer Portal for all-member broadcast DMs.
ENABLE_MEMBERS_INTENT=false
# Maximum combined channel+deduplicated-user destinations per announcement, >=1.
ADMIN_MAX_RECIPIENTS=1000
# Send previews allowed per operator per ADMIN_SEND_RATE_LIMIT_WINDOW_SECONDS, >=1.
ADMIN_SEND_RATE_LIMIT_COUNT=5
# Rolling send-preview window, >=1. Every send requires a one-use, 120-second confirmation.
ADMIN_SEND_RATE_LIMIT_WINDOW_SECONDS=300
# Delay between announcement destinations, >=1; Discord's own API rate limits also apply.
ADMIN_SEND_INTERVAL_SECONDS=1
# Operator Activity inbox/state reads per user per 60 seconds, >=1 (not the send budget).
ADMIN_UI_RATE_LIMIT_COUNT=120

# Enable AND turn on Message Content Intent for full non-mention replies/configured channels.
# DMs and direct bot mentions work without this. No unrelated channel collection by default.
INBOX_MESSAGE_CONTENT=false
# Optional comma-separated channel IDs to collect beyond DMs/mentions/resolved bot replies.
# Needs Message Content Intent for full text; collection starts while the bot is online.
INBOX_CHANNEL_IDS=
# Retained inbox age in days, >=1; older messages pruned on receipt/read. No history backfill.
INBOX_RETENTION_DAYS=7
# Maximum retained inbox messages across all users/guilds, >=1; oldest rows pruned first.
INBOX_MAX_MESSAGES=10000

# JSON device label -> Jellyfin base URL (no /web), at most 20 labels of 1-80 characters.
# {} uses Seerr's discovered Browser link only; extra URLs must target the same server.
JELLYFIN_DEVICE_URLS={}

# Optional Radarr base URL (no /api/v3); enable only with RADARR_API_KEY. Used for library/storage.
# Legacy override, ignored while SEERR_DISCOVERY=true; Seerr owns movie/TV configuration.
RADARR_URL=
# Radarr API key; required together with RADARR_URL. Empty pair disables this integration.
RADARR_API_KEY=
# Optional Sonarr base URL (no /api/v3); enable only with SONARR_API_KEY. Library/storage only.
# Legacy override, ignored while SEERR_DISCOVERY=true.
SONARR_URL=
# Sonarr API key; required together with SONARR_URL. Seerr still routes TV requests/deletions.
SONARR_API_KEY=
# Optional Lidarr base URL (no /api/v1); enable only with LIDARR_API_KEY. Albums/library/storage.
LIDARR_URL=
# Lidarr API key; required together with LIDARR_URL. Empty pair disables music integration.
LIDARR_API_KEY=
# Optional compatible Readarr v1 base URL (no /api/v1); requires READARR_API_KEY.
READARR_URL=
# Readarr API key; required together with READARR_URL. Empty pair disables book integration.
READARR_API_KEY=

# Combined music/book additions per user per rolling 24 hours, >=1; requires Seerr REQUEST.
ARR_REQUEST_LIMIT_PER_DAY=10
# Existing root-folder path as configured in Lidarr; required for additions, not browsing.
LIDARR_ROOT_FOLDER=
# Existing Lidarr quality-profile ID. 0 is unset; positive configured ID required for additions.
LIDARR_QUALITY_PROFILE_ID=0
# Existing Lidarr metadata-profile ID. 0 is unset; positive configured ID required for additions.
LIDARR_METADATA_PROFILE_ID=0
# Existing root-folder path as configured in Readarr; required for additions, not browsing.
READARR_ROOT_FOLDER=
# Existing Readarr quality-profile ID. 0 is unset; positive configured ID required for additions.
READARR_QUALITY_PROFILE_ID=0
# Existing Readarr metadata-profile ID. 0 is unset; positive configured ID required for additions.
READARR_METADATA_PROFILE_ID=0

# HTTP listener address, used only when Activity enabled or WEBHOOK_SECRET set.
# Loopback for local tunnels/proxies; use 0.0.0.0 in Docker behind a private proxy/network.
BOT_HOST=127.0.0.1
# HTTP listener port, 1-65535. Unused in pure slash mode (Activity false + empty webhook secret).
BOT_PORT=8080
# Optional HTTP(S) backend base URL for panel reachability tests; does not construct routes.
# Local service webhooks can use a private address; external senders require a reachable URL.
WEBHOOK_PUBLIC_URL=
# Optional random webhook credential, >=32 characters. Empty disables webhook authentication.
# Nonempty starts listener even with Activity disabled. Routes: /webhooks/seerr|radarr|sonarr|lidarr|readarr.
# Bearer auth or Basic username bot/password this secret; payloads only trigger verified refreshes.
WEBHOOK_SECRET=
# Webhook notifications per client IP AND per source per 60 seconds, >=1. Forwarded IPs ignored.
WEBHOOK_RATE_LIMIT_COUNT=60
